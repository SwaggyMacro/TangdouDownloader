<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>1.0.2</Version>
    <ApplicationIcon>Assets\logo.ico</ApplicationIcon>
    <InterceptorsNamespaces>$(InterceptorsNamespaces);Aprillz.MewUI.Generated</InterceptorsNamespaces>
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Aprillz.MewUI" Version="0.21.1" ExcludeAssets="compile" />
    <PackageReference Include="Aprillz.MewUI.Platform.Win32" Version="0.21.1" />
    <PackageReference Include="Aprillz.MewUI.Backend.Gdi" Version="0.21.1" />
    <PackageReference Include="Aprillz.MewUI.Platform.MacOS" Version="0.21.1" />
    <PackageReference Include="Aprillz.MewUI.Backend.MewVG.MacOS" Version="0.21.1" />
    <PackageReference Include="Aprillz.MewUI.Platform.X11" Version="0.21.1" />
    <PackageReference Include="Aprillz.MewUI.Backend.MewVG.X11" Version="0.21.1" />
    <PackageReference Include="Imazen.WebP.NativeRuntime.linux-arm64" Version="1.6.1" />
    <PackageReference Include="Imazen.WebP.NativeRuntime.linux-x64" Version="1.6.1" />
    <PackageReference Include="Imazen.WebP.NativeRuntime.osx-arm64" Version="1.6.1" />
    <PackageReference Include="Imazen.WebP.NativeRuntime.osx-x64" Version="1.6.1" />
    <PackageReference Include="Imazen.WebP.NativeRuntime.win-arm64" Version="1.6.1" />
    <PackageReference Include="Imazen.WebP.NativeRuntime.win-x64" Version="1.6.1" />
    <ProjectReference Include="..\TangdouDownloader.Core\TangdouDownloader.Core.csproj" />
    <ProjectReference Include="..\TangdouDownloader.MewUI\TangdouDownloader.MewUI.csproj" />
    <PackageReference Include="Aprillz.MewUI.Core" Version="0.21.1" ExcludeAssets="all" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets\logo.ico" />
  </ItemGroup>
  <ItemGroup Condition="'$(RuntimeIdentifier)' != ''">
    <None Include="$(NuGetPackageRoot)imazen.webp.nativeruntime.$(RuntimeIdentifier)\1.6.1\runtimes\$(RuntimeIdentifier)\native\*"
          Link="%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          Visible="false" />
  </ItemGroup>
  <Target Name="RemoveNativeDebugSymbols" AfterTargets="Publish">
    <Delete Files="$(PublishDir)*.pdb" />
  </Target>
</Project>
